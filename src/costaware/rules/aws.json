{
  "_doc": [
    "Rule table. Within a service, rules are tried in order and the first match wins.",
    "Then global_rules, then the service's default_read/default_write, and finally UNKNOWN.",
    "cost: free | request (small per-request fee) | usage (~$0 while idle, pay as you use) |",
    "      recurring (costs money even while idle; monthly_usd) | one_time (usd) | variable (size-dependent, needs an estimate)",
    "when: {\"--flag\": true|false|\"value\"|[\"values\"]}; use the @ prefix for derived facts such as \"@direction\".",
    "Prices are approximate us-east-1 list prices. Rules with confidence: low need verification."
  ],
  "global_rules": [
    {"op": ["tag-*", "untag-*", "create-tags", "delete-tags", "add-tags*", "remove-tags*"], "cost": "free"},
    {"op": ["delete-*", "deregister-*", "release-*", "terminate-*", "stop-*", "disable-*"], "cost": "free",
     "note": "Deleting or stopping does not incur cost."}
  ],
  "services": {
    "sts": {
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free", "note": "STS calls are free."}
    },
    "iam": {
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free", "note": "IAM is free."}
    },
    "pricing": {
      "default_read": {"cost": "free", "note": "The Price List API is free."}
    },
    "ec2": {
      "rules": [
        {"op": "*", "when": {"--dry-run": true}, "cost": "free", "note": "--dry-run only checks permissions."},
        {"op": ["run-instances", "run-scheduled-instances", "request-spot-instances", "request-spot-fleet", "create-fleet"],
         "cost": "recurring", "note": "Instances are billed hourly while running; EBS volumes are billed separately per GB-month."},
        {"op": "start-instances", "cost": "recurring", "note": "A stopped instance starts billing hourly again."},
        {"op": "create-nat-gateway", "cost": "recurring", "monthly_usd": 32.85,
         "note": "NAT Gateway ~$0.045/hour (~$33/month) + $0.045/GB processed."},
        {"op": "allocate-address", "cost": "recurring", "monthly_usd": 3.65,
         "note": "Public IPv4 address $0.005/hour (~$3.65/month), attached to a resource or not."},
        {"op": "create-volume", "cost": "recurring", "note": "EBS volumes are billed per GB-month (gp3 ~$0.08/GB-month), even when unattached."},
        {"op": "modify-volume", "cost": "recurring", "note": "Increasing volume size/IOPS raises the monthly cost."},
        {"op": "modify-instance-attribute", "when": {"--instance-type": true}, "cost": "recurring",
         "note": "Changing the instance type changes the hourly rate."},
        {"op": ["create-snapshot", "create-snapshots", "copy-snapshot", "create-image", "copy-image"], "cost": "recurring",
         "note": "Snapshot storage ~$0.05/GB-month; cross-region copies also incur data transfer."},
        {"op": "create-vpc-endpoint", "when": {"--vpc-endpoint-type": ["Interface", "GatewayLoadBalancer"]},
         "cost": "recurring", "monthly_usd": 7.3,
         "note": "Interface endpoint ~$0.01/hour per AZ (~$7.3/month) + $0.01/GB."},
        {"op": "create-vpc-endpoint", "cost": "free", "note": "Gateway endpoints (S3/DynamoDB) are free."},
        {"op": "create-transit-gateway-*-attachment", "cost": "recurring", "monthly_usd": 36.5,
         "note": "Transit Gateway attachment ~$0.05/hour (~$36.5/month) + $0.02/GB."},
        {"op": "create-client-vpn-endpoint", "cost": "recurring",
         "note": "Client VPN: hourly fee per associated subnet + hourly fee per connection."},
        {"op": ["create-vpn-connection"], "cost": "recurring", "monthly_usd": 36.5,
         "note": "Site-to-Site VPN ~$0.05/hour (~$36.5/month)."},
        {"op": ["purchase-reserved-instances-offering", "purchase-host-reservation", "purchase-scheduled-instances",
                "allocate-hosts", "purchase-capacity-block"],
         "cost": "one_time", "note": "Committed purchase: may involve a large upfront payment or a non-refundable commitment."},
        {"op": ["create-*", "modify-*", "authorize-*", "revoke-*", "associate-*", "disassociate-*", "attach-*",
                "detach-*", "import-key-pair", "reboot-instances", "replace-*", "enable-*", "reset-*"],
         "cost": "free"}
      ],
      "default_read": {"cost": "free"}
    },
    "s3": {
      "rules": [
        {"op": "ls", "when": {"--recursive": true}, "cost": "request",
         "note": "One LIST request per 1,000 objects ($0.005/1,000 requests). 1 million objects ~$0.005."},
        {"op": "ls", "cost": "request", "note": "LIST request, $0.005/1,000 requests."},
        {"op": ["cp", "mv", "sync"], "when": {"@direction": "download"}, "cost": "variable",
         "note": "Data transfer to the internet ~$0.09/GB (first 100GB/month free) + GET requests. Free to EC2 in the same region."},
        {"op": ["cp", "mv", "sync"], "cost": "usage",
         "note": "PUT/COPY requests ($0.005/1,000) + storage (Standard ~$0.023/GB-month)."},
        {"op": "rm", "when": {"--recursive": true}, "cost": "request", "note": "LIST requests are billed, DELETE is free."},
        {"op": ["rm", "mb", "rb", "presign", "website"], "cost": "free"}
      ]
    },
    "s3api": {
      "rules": [
        {"op": ["get-object", "get-object-torrent"], "cost": "request",
         "note": "GET $0.0004/1,000 requests + transfer to the internet ~$0.09/GB (depends on object size)."},
        {"op": ["select-object-content", "restore-object"], "cost": "variable",
         "note": "Depends on the amount of data scanned/restored (including Glacier retrieval fees)."},
        {"op": ["delete-object", "delete-objects"], "cost": "free",
         "note": "DELETE is free; deleting from Glacier/IA before the minimum storage duration incurs an early deletion fee."},
        {"op": ["list-*"], "cost": "request", "note": "LIST request, $0.005/1,000 requests."},
        {"op": ["put-object", "copy-object", "upload-part", "upload-part-copy", "create-multipart-upload",
                "complete-multipart-upload"], "cost": "usage",
         "note": "PUT/COPY $0.005/1,000 requests + storage (Standard ~$0.023/GB-month)."}
      ],
      "default_read": {"cost": "request", "note": "GET/HEAD $0.0004/1,000 requests."},
      "default_write": {"cost": "request", "note": "PUT-class request, $0.005/1,000 requests."}
    },
    "athena": {
      "rules": [
        {"op": "start-query-execution", "cost": "variable",
         "note": "$5/TB of data scanned, minimum 10MB per query. Estimating needs the Athena scan estimator."},
        {"op": ["start-session", "start-calculation-execution"], "cost": "variable",
         "note": "Spark: ~$0.35 per DPU-hour while the session is open."},
        {"op": ["create-capacity-reservation", "update-capacity-reservation"], "cost": "recurring",
         "note": "Provisioned capacity billed per DPU-hour (~$0.30), minimum 24 DPUs."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "glue": {
      "rules": [
        {"op": ["start-job-run", "start-crawler", "start-workflow-run", "start-ml-*", "start-data-quality-*"],
         "cost": "variable", "note": "~$0.44 per DPU-hour, depends on run time."},
        {"op": ["create-dev-endpoint", "create-session"], "cost": "recurring",
         "note": "Billed per DPU-hour while it stays open."}
      ],
      "default_read": {"cost": "request", "note": "Data Catalog: first 1M requests/month free, then $1/1M requests."},
      "default_write": {"cost": "request", "note": "Data Catalog: first 1M requests/month free, then $1/1M requests."}
    },
    "dynamodb": {
      "rules": [
        {"op": "scan", "cost": "variable",
         "note": "Reads the whole table, every 4KB consumes a read unit (on-demand ~$0.125/1M RRU). Depends on table size."},
        {"op": ["execute-statement", "batch-execute-statement", "execute-transaction"], "cost": "variable",
         "note": "A PartiQL statement without a key condition can do a full table scan."},
        {"op": ["get-item", "batch-get-item", "query", "transact-get-items"], "cost": "request",
         "note": "Consumes read units (on-demand ~$0.125/1M RRU)."},
        {"op": ["put-item", "update-item", "delete-item", "batch-write-item", "transact-write-items"], "cost": "request",
         "note": "Consumes write units (on-demand ~$0.625/1M WRU)."},
        {"op": "create-table", "when": {"--billing-mode": "PAY_PER_REQUEST"}, "cost": "usage",
         "note": "On-demand: only storage while idle (~$0.25/GB-month)."},
        {"op": "create-table", "cost": "recurring",
         "note": "Default PROVISIONED mode: read/write capacity is billed hourly even if unused."},
        {"op": "update-table", "cost": "recurring", "note": "Capacity, replica or table class changes can change the monthly cost."},
        {"op": ["create-backup", "update-continuous-backups"], "cost": "recurring",
         "note": "Backups ~$0.10/GB-month, PITR ~$0.20/GB-month."},
        {"op": ["restore-table-*", "export-table-to-point-in-time", "import-table"], "cost": "variable",
         "note": "Billed per GB of data."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "lambda": {
      "rules": [
        {"op": ["invoke", "invoke-async", "invoke-with-response-stream"], "cost": "request",
         "note": "$0.20/1M requests + duration (GB-seconds). First 1M requests/month free."},
        {"op": ["create-function", "update-function-code"], "cost": "usage", "note": "Free while idle; billed per invocation."},
        {"op": "put-provisioned-concurrency-config", "cost": "recurring",
         "note": "Provisioned concurrency is billed hourly even if unused."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "logs": {
      "rules": [
        {"op": "start-query", "cost": "variable", "note": "Logs Insights: $0.005/GB of data scanned."},
        {"op": "start-live-tail", "cost": "request", "note": "Live Tail ~$0.01/minute."},
        {"op": ["create-log-group", "put-log-events"], "cost": "usage",
         "note": "Ingestion ~$0.50/GB, storage ~$0.03/GB-month. Default retention is forever; set a retention policy."}
      ],
      "default_read": {"cost": "free", "confidence": "low",
                       "note": "No separate charge known for GetLogEvents/FilterLogEvents; needs verification."},
      "default_write": {"cost": "free"}
    },
    "cloudwatch": {
      "rules": [
        {"op": ["get-metric-data", "get-insight-rule-report"], "cost": "request",
         "note": "$0.01 per 1,000 metrics requested (not covered by the free tier)."},
        {"op": "get-metric-widget-image", "cost": "request", "note": "$0.02 per 1,000 metrics."},
        {"op": "put-metric-alarm", "cost": "recurring", "monthly_usd": 0.1,
         "note": "Standard alarm $0.10/month (high resolution $0.30/month)."},
        {"op": "put-composite-alarm", "cost": "recurring", "monthly_usd": 0.5, "note": "Composite alarm $0.50/month."},
        {"op": "put-dashboard", "cost": "recurring", "monthly_usd": 3.0, "note": "$3/month per dashboard (first 3 free)."},
        {"op": "put-metric-data", "cost": "usage",
         "note": "$0.01/1,000 requests; a new custom metric costs ~$0.30/month per metric."}
      ],
      "default_read": {"cost": "request", "note": "CloudWatch API requests $0.01/1,000 requests (first 1M/month free)."},
      "default_write": {"cost": "request", "note": "CloudWatch API requests $0.01/1,000 requests (first 1M/month free)."}
    },
    "ce": {
      "rules": [
        {"op": "*", "cost": "request", "note": "Cost Explorer API: $0.01 per request (each page is a request)."}
      ]
    },
    "kms": {
      "rules": [
        {"op": ["create-key", "replicate-key"], "cost": "recurring", "monthly_usd": 1.0,
         "note": "Customer managed key $1/month (+ extra per rotation)."},
        {"op": ["schedule-key-deletion", "cancel-key-deletion"], "cost": "free"}
      ],
      "default_read": {"cost": "request", "note": "$0.03/10,000 requests, first 20,000 requests/month free."},
      "default_write": {"cost": "request", "note": "$0.03/10,000 requests, first 20,000 requests/month free."}
    },
    "secretsmanager": {
      "rules": [
        {"op": ["create-secret", "replicate-secret-to-regions"], "cost": "recurring", "monthly_usd": 0.4,
         "note": "$0.40/month per secret (and per replica) + $0.05/10,000 API calls."}
      ],
      "default_read": {"cost": "request", "note": "$0.05/10,000 API calls."},
      "default_write": {"cost": "request", "note": "$0.05/10,000 API calls."}
    },
    "ssm": {
      "rules": [
        {"op": "put-parameter", "when": {"--tier": ["Advanced", "Intelligent-Tiering"]}, "cost": "recurring",
         "monthly_usd": 0.05, "note": "Advanced parameter $0.05/month + higher-throughput API fees."},
        {"op": "put-parameter", "cost": "free", "note": "Standard parameters are free."}
      ],
      "default_read": {"cost": "free", "note": "Free at standard throughput."},
      "default_write": {"cost": "free", "confidence": "low",
                        "note": "Run Command/Session Manager are free for EC2; Automation and on-prem nodes may be billed."}
    },
    "rds": {
      "rules": [
        {"op": ["create-db-instance", "create-db-cluster", "create-db-instance-read-replica", "restore-db-instance-*",
                "restore-db-cluster-*", "start-db-instance", "start-db-cluster", "create-db-proxy",
                "create-blue-green-deployment", "create-global-cluster", "modify-db-instance", "modify-db-cluster"],
         "cost": "recurring", "note": "Hourly by instance class + storage per GB-month. Multi-AZ doubles the cost."},
        {"op": ["create-db-snapshot", "create-db-cluster-snapshot", "copy-db-snapshot", "copy-db-cluster-snapshot"],
         "cost": "recurring", "note": "Manual snapshot storage is billed per GB-month."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elbv2": {
      "rules": [
        {"op": "create-load-balancer", "cost": "recurring", "monthly_usd": 16.43,
         "note": "ALB/NLB ~$0.0225/hour (~$16.4/month) + LCU/NLCU usage."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elb": {
      "rules": [
        {"op": "create-load-balancer", "cost": "recurring", "monthly_usd": 18.25,
         "note": "Classic LB ~$0.025/hour (~$18/month) + $0.008/GB."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "route53": {
      "rules": [
        {"op": "create-hosted-zone", "cost": "recurring", "monthly_usd": 0.5, "note": "Hosted zone $0.50/month + DNS queries."},
        {"op": "create-health-check", "cost": "recurring", "monthly_usd": 0.5,
         "note": "Health check $0.50/month ($0.75/month for non-AWS endpoints)."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "route53domains": {
      "rules": [
        {"op": ["register-domain", "transfer-domain", "renew-domain"], "cost": "one_time",
         "note": "Domain fee depends on the TLD and is usually non-refundable."}
      ],
      "default_read": {"cost": "free"}
    },
    "sqs": {
      "rules": [
        {"op": "create-queue", "cost": "usage", "note": "Free while idle; billed per request."},
        {"op": "*", "cost": "request", "note": "Every API request is billed: $0.40/1M requests (first 1M/month free)."}
      ]
    },
    "sns": {
      "rules": [
        {"op": "publish", "when": {"--phone-number": true}, "cost": "request",
         "note": "SMS is billed per message and varies by country."},
        {"op": ["publish", "publish-batch"], "cost": "request", "note": "$0.50/1M publishes (first 1M/month free) + delivery fees."},
        {"op": "create-topic", "cost": "usage", "note": "Free while idle."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "cloudformation": {
      "rules": [
        {"op": ["create-stack", "update-stack", "deploy", "create-change-set", "execute-change-set",
                "create-stack-set", "update-stack-set", "create-stack-instances"],
         "cost": "variable", "note": "Cost depends on the resources the stack creates; review the template."},
        {"op": ["package", "validate-template", "estimate-template-cost"], "cost": "free"}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "ecs": {
      "rules": [
        {"op": ["create-service", "update-service", "run-task", "start-task"], "cost": "recurring",
         "note": "Fargate: vCPU-hours + GB-hours; EC2 launch type: the underlying instances."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "eks": {
      "rules": [
        {"op": "create-cluster", "cost": "recurring", "monthly_usd": 73.0,
         "note": "Control plane $0.10/hour (~$73/month), nodes billed separately."},
        {"op": ["create-nodegroup", "update-nodegroup-config"], "cost": "recurring", "note": "Node instances are billed hourly."},
        {"op": "create-fargate-profile", "cost": "usage", "note": "vCPU/GB-hours billed while pods run."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "ecr": {
      "rules": [
        {"op": "create-repository", "cost": "usage", "note": "Storage ~$0.10/GB-month."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elasticache": {
      "rules": [
        {"op": ["create-cache-cluster", "create-replication-group", "create-serverless-cache", "modify-cache-cluster",
                "modify-replication-group", "increase-replica-count"], "cost": "recurring",
         "note": "Billed hourly by node type."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "opensearch": {
      "rules": [
        {"op": ["create-domain", "update-domain-config"], "cost": "recurring", "note": "Instance-hours + EBS GB-month."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "redshift": {
      "rules": [
        {"op": ["create-cluster", "resume-cluster", "restore-from-cluster-snapshot", "modify-cluster", "resize-cluster"],
         "cost": "recurring", "note": "Billed per node-hour."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "sagemaker": {
      "rules": [
        {"op": ["create-endpoint", "update-endpoint", "create-notebook-instance", "start-notebook-instance",
                "create-inference-component"], "cost": "recurring",
         "note": "Billed hourly while the instance is up (GPU instances are expensive)."},
        {"op": ["create-training-job", "create-processing-job", "create-transform-job", "create-hyper-parameter-tuning-job"],
         "cost": "variable", "note": "Instance type × duration."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "bedrock-runtime": {
      "rules": [
        {"op": "*", "cost": "variable", "note": "Billed by model and token count."}
      ]
    }
  }
}
