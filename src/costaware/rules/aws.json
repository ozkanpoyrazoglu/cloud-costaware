{
  "_doc": [
    "Rule table. Within a service, rules are tried in order and the first match wins.",
    "Then global_rules, then the service's default_read/default_write, and finally UNKNOWN.",
    "cost: free | request (small per-request fee) | usage (nothing while idle, pay as you use) |",
    "      recurring (costs money even while idle) | one_time | variable (size-dependent, needs an estimate)",
    "when: {\"--flag\": true|false|\"value\"|[\"values\"]}; use the @ prefix for derived facts such as \"@direction\".",
    "price: how to look up the on-demand list price in the AWS Price List API, never the price itself: an estimator",
    "       (ec2 | ebs | rds) or a list of components {service, filters, per, scale?, idle?, count?, global?,",
    "       region_field?}. See pricing.py. A recurring cost is HIGH unless its idle components are all found",
    "       and add up to less than high_monthly_usd.",
    "show: arguments to list in the confirmation, e.g. [\"--instance-type\", \"--block-device-mappings.VolumeSize\"] (a field inside a JSON/shorthand argument).",
    "Rules with confidence: low need verification."
  ],
  "global_rules": [
    {"op": ["tag-*", "untag-*", "create-tags", "delete-tags", "add-tags*", "remove-tags*"], "cost": "free"},
    {"op": ["delete-*", "deregister-*", "release-*", "terminate-*", "stop-*", "disable-*"], "cost": "free",
     "note": "Deleting or stopping does not incur cost."}
  ],
  "services": {
    "sts": {
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free", "note": "STS calls are free."}
    },
    "iam": {
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free", "note": "IAM is free."}
    },
    "pricing": {
      "default_read": {"cost": "free", "note": "The Price List API is free."}
    },
    "ec2": {
      "rules": [
        {"op": "*", "when": {"--dry-run": true}, "cost": "free", "note": "--dry-run only checks permissions."},
        {"op": ["run-instances", "run-scheduled-instances", "request-spot-instances", "request-spot-fleet", "create-fleet"],
         "cost": "recurring", "note": "Instances are billed hourly while running; EBS volumes are billed separately per GB-month.",
         "price": "ec2",
         "show": ["--instance-type", "--count", "--max-count", "--instance-count", "--spot-price",
                  "--block-device-mappings.VolumeSize", "--block-device-mappings.VolumeType",
                  "--target-capacity-specification.TotalTargetCapacity"]},
        {"op": "start-instances", "cost": "recurring", "note": "A stopped instance starts billing hourly again.",
         "show": ["--instance-ids"]},
        {"op": "create-nat-gateway", "cost": "recurring",
         "note": "Billed hourly while it exists, plus per GB processed.",
         "price": [
           {"service": "AmazonEC2", "filters": {"productFamily": "NAT Gateway", "operation": "NatGateway", "usagetype": "~NatGateway-Hours"},
            "per": "hour", "idle": "hour"},
           {"service": "AmazonEC2", "filters": {"productFamily": "NAT Gateway", "operation": "NatGateway", "usagetype": "~NatGateway-Bytes"},
            "per": "GB processed"}]},
        {"op": "allocate-address", "cost": "recurring",
         "note": "Public IPv4 addresses are billed hourly, attached to a resource or not.",
         "price": [
           {"service": "AmazonVPC", "filters": {"group": "VPCPublicIPv4Address", "usagetype": "~PublicIPv4:IdleAddress"},
            "per": "hour", "idle": "hour"}]},
        {"op": "create-volume", "cost": "recurring", "note": "EBS volumes are billed per GB-month, even when unattached.",
         "price": "ebs", "show": ["--size", "--volume-type", "--iops", "--throughput"]},
        {"op": "modify-volume", "cost": "recurring", "note": "Increasing volume size/IOPS raises the monthly cost.",
         "show": ["--size", "--volume-type", "--iops", "--throughput"]},
        {"op": "modify-instance-attribute", "when": {"--instance-type": true}, "cost": "recurring",
         "note": "Changing the instance type changes the hourly rate.", "show": ["--instance-type.Value"]},
        {"op": ["create-snapshot", "create-snapshots", "copy-snapshot", "create-image", "copy-image"], "cost": "recurring",
         "note": "Snapshot storage is billed per GB-month; cross-region copies also incur data transfer.",
         "price": [
           {"service": "AmazonEC2", "filters": {"productFamily": "Storage Snapshot", "usagetype": "~EBS:SnapshotUsage",
                                                "locationType": "AWS Region"},
            "per": "GB-month"}]},
        {"op": "create-vpc-endpoint", "when": {"--vpc-endpoint-type": "Interface"}, "cost": "recurring",
         "note": "Billed hourly per AZ (one per subnet) while it exists, plus per GB processed.",
         "show": ["--service-name", "--subnet-ids"],
         "price": [
           {"service": "AmazonVPC", "filters": {"endpointType": "PrivateLink", "usagetype": "~VpcEndpoint-Hours"},
            "per": "hour", "idle": "hour", "count": "--subnet-ids"},
           {"service": "AmazonVPC", "filters": {"endpointType": "PrivateLink", "usagetype": "~VpcEndpoint-Bytes"},
            "per": "GB processed"}]},
        {"op": "create-vpc-endpoint", "when": {"--vpc-endpoint-type": "GatewayLoadBalancer"}, "cost": "recurring",
         "note": "Billed hourly while it exists, plus per GB processed.",
         "price": [
           {"service": "AmazonVPC", "filters": {"endpointType": "Gateway Load Balancer Endpoint",
                                                "usagetype": "~VpcEndpoint-GWLBE-Hours"},
            "per": "hour", "idle": "hour"},
           {"service": "AmazonVPC", "filters": {"endpointType": "Gateway Load Balancer Endpoint",
                                                "usagetype": "~VpcEndpoint-GWLBE-Bytes"},
            "per": "GB processed"}]},
        {"op": "create-vpc-endpoint", "cost": "free", "note": "Gateway endpoints (S3/DynamoDB) are free."},
        {"op": "create-transit-gateway-vpc-attachment", "cost": "recurring",
         "note": "Billed hourly per attachment while it exists, plus per GB processed.",
         "price": [
           {"service": "AmazonVPC", "filters": {"group": "AWSTransitGateway", "usagetype": "~TransitGateway-Hours",
                                                "operation": "TransitGatewayVPC"},
            "per": "hour", "idle": "hour"},
           {"service": "AmazonVPC", "filters": {"group": "AWSTransitGateway", "usagetype": "~TransitGateway-Bytes",
                                                "operation": "TransitGatewayVPC"},
            "per": "GB processed"}]},
        {"op": "create-transit-gateway-peering-attachment", "cost": "recurring",
         "note": "Billed hourly per attachment while it exists, plus inter-region data transfer.",
         "price": [
           {"service": "AmazonVPC", "filters": {"group": "AWSTransitGateway", "usagetype": "~TransitGateway-Hours",
                                                "operation": "TransitGatewayPeering"},
            "per": "hour", "idle": "hour"}]},
        {"op": "create-transit-gateway-connect", "cost": "recurring",
         "note": "Billed hourly per attachment while it exists, plus per GB processed.",
         "price": [
           {"service": "AmazonVPC", "filters": {"group": "AWSTransitGateway", "usagetype": "~TransitGateway-Hours",
                                                "operation": "TransitGatewayConnect"},
            "per": "hour", "idle": "hour"}]},
        {"op": "create-transit-gateway-*-attachment", "cost": "recurring",
         "note": "Transit Gateway attachments are billed hourly while they exist, plus per GB processed."},
        {"op": "create-client-vpn-endpoint", "cost": "recurring",
         "note": "Client VPN: billed per associated subnet per hour, plus per connection per hour.",
         "price": [
           {"service": "AmazonVPC", "filters": {"group": "AWSClientVPN", "usagetype": "~ClientVPN-EndpointHours"},
            "per": "subnet association hour"},
           {"service": "AmazonVPC", "filters": {"group": "AWSClientVPN", "usagetype": "~ClientVPN-ConnectionHours"},
            "per": "connection hour"}]},
        {"op": ["create-vpn-connection"], "cost": "recurring", "note": "Site-to-Site VPN is billed per connection-hour.",
         "price": [
           {"service": "AmazonVPC", "filters": {"productFamily": "Cloud Connectivity", "usagetype": "~VPN-Usage-Hours:ipsec.1"},
            "per": "hour", "idle": "hour"}]},
        {"op": ["purchase-reserved-instances-offering", "purchase-host-reservation", "purchase-scheduled-instances",
                "allocate-hosts", "purchase-capacity-block"],
         "cost": "one_time", "note": "Committed purchase: may involve a large upfront payment or a non-refundable commitment."},
        {"op": ["create-*", "modify-*", "authorize-*", "revoke-*", "associate-*", "disassociate-*", "attach-*",
                "detach-*", "import-key-pair", "reboot-instances", "replace-*", "enable-*", "reset-*"],
         "cost": "free"}
      ],
      "default_read": {"cost": "free"}
    },
    "s3": {
      "rules": [
        {"op": "ls", "when": {"--recursive": true}, "cost": "request",
         "note": "One LIST request per 1,000 objects listed.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 LIST requests", "scale": 1000}]},
        {"op": "ls", "cost": "request", "note": "A LIST request.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 LIST requests", "scale": 1000}]},
        {"op": ["cp", "mv", "sync"], "when": {"@direction": "download"}, "cost": "variable",
         "note": "Data transfer to the internet per GB (a monthly free allowance applies) + GET requests. Free to EC2 in the same region.",
         "price": [
           {"service": "AWSDataTransfer", "filters": {"usagetype": "~DataTransfer-Out-Bytes", "toLocation": "External"},
            "region_field": "fromRegionCode", "per": "GB to the internet"},
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier2", "usagetype": "~Requests-Tier2"},
            "per": "1,000 GET requests", "scale": 1000}]},
        {"op": ["cp", "mv", "sync"], "cost": "usage",
         "note": "PUT/COPY requests + storage per GB-month.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 PUT requests", "scale": 1000},
           {"service": "AmazonS3", "filters": {"productFamily": "Storage", "volumeType": "Standard",
                                               "usagetype": "~TimedStorage-ByteHrs"},
            "per": "GB-month (Standard)"}]},
        {"op": "rm", "when": {"--recursive": true}, "cost": "request", "note": "LIST requests are billed, DELETE is free.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 LIST requests", "scale": 1000}]},
        {"op": ["rm", "mb", "rb", "presign", "website"], "cost": "free"}
      ]
    },
    "s3api": {
      "rules": [
        {"op": ["get-object", "get-object-torrent"], "cost": "request",
         "note": "A GET request + data transfer to the internet (depends on object size).",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier2", "usagetype": "~Requests-Tier2"},
            "per": "1,000 GET requests", "scale": 1000},
           {"service": "AWSDataTransfer", "filters": {"usagetype": "~DataTransfer-Out-Bytes", "toLocation": "External"},
            "region_field": "fromRegionCode", "per": "GB to the internet"}]},
        {"op": ["select-object-content", "restore-object"], "cost": "variable",
         "note": "Depends on the amount of data scanned/restored (including Glacier retrieval fees)."},
        {"op": ["delete-object", "delete-objects"], "cost": "free",
         "note": "DELETE is free; deleting from Glacier/IA before the minimum storage duration incurs an early deletion fee."},
        {"op": ["list-*"], "cost": "request", "note": "A LIST request.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 LIST requests", "scale": 1000}]},
        {"op": ["put-object", "copy-object", "upload-part", "upload-part-copy", "create-multipart-upload",
                "complete-multipart-upload"], "cost": "usage",
         "note": "PUT/COPY requests + storage per GB-month.",
         "price": [
           {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1,000 PUT requests", "scale": 1000},
           {"service": "AmazonS3", "filters": {"productFamily": "Storage", "volumeType": "Standard",
                                               "usagetype": "~TimedStorage-ByteHrs"},
            "per": "GB-month (Standard)"}]}
      ],
      "default_read": {"cost": "request", "note": "A GET/HEAD-class request.",
                       "price": [
                         {"service": "AmazonS3", "filters": {"group": "S3-API-Tier2", "usagetype": "~Requests-Tier2"},
                          "per": "1,000 requests", "scale": 1000}]},
      "default_write": {"cost": "request", "note": "A PUT-class request.",
                        "price": [
                          {"service": "AmazonS3", "filters": {"group": "S3-API-Tier1", "usagetype": "~Requests-Tier1"},
                           "per": "1,000 requests", "scale": 1000}]}
    },
    "athena": {
      "rules": [
        {"op": "start-query-execution", "cost": "variable",
         "note": "Billed per TB of data scanned, with a 10 MB minimum per query. Size the scan with free calls first.",
         "price": [
           {"service": "AmazonAthena", "filters": {"productFamily": "Athena Queries", "usagetype": "~DataScannedInTB"},
            "per": "TB scanned"}]},
        {"op": ["start-session", "start-calculation-execution"], "cost": "variable",
         "note": "Spark: billed per DPU-hour while the session is open.",
         "price": [
           {"service": "AmazonAthena", "filters": {"productFamily": "Athena Spark", "usagetype": "~CodeExecutionInDPUHours"},
            "per": "DPU-hour"}]},
        {"op": ["create-capacity-reservation", "update-capacity-reservation"], "cost": "recurring",
         "note": "Provisioned capacity is billed per DPU-hour while active, with a minimum number of DPUs.",
         "show": ["--target-dpus"],
         "price": [
           {"service": "AmazonAthena", "filters": {"productFamily": "Athena Queries", "usagetype": "~ReservedCapacityInDPUHours"},
            "per": "DPU-hour"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "glue": {
      "rules": [
        {"op": ["start-job-run", "start-crawler", "start-workflow-run", "start-ml-*", "start-data-quality-*"],
         "cost": "variable", "note": "Billed per DPU-hour, depends on run time.",
         "price": [
           {"service": "AWSGlue", "filters": {"group": "ETL Job run", "usagetype": "~ETL-DPU-Hour"},
            "per": "DPU-hour (ETL job)"}]},
        {"op": "create-dev-endpoint", "cost": "recurring", "note": "Billed per DPU-hour while it stays open.",
         "price": [
           {"service": "AWSGlue", "filters": {"group": "ETL Development endpoint", "usagetype": "~DEVED-DPU-Hour"},
            "per": "DPU-hour"}]},
        {"op": "create-session", "cost": "recurring", "note": "Billed per DPU-hour while it stays open.",
         "price": [
           {"service": "AWSGlue", "filters": {"group": "ETL Interactive Session", "usagetype": "~GlueInteractiveSession-DPU-Hour"},
            "per": "DPU-hour"}]}
      ],
      "default_read": {"cost": "request", "note": "Data Catalog request (a monthly free allowance applies).",
                       "price": [
                         {"service": "AWSGlue", "filters": {"group": "Data catalog requests", "usagetype": "~Catalog-Request"},
                          "per": "1M requests", "scale": 1000000}]},
      "default_write": {"cost": "request", "note": "Data Catalog request (a monthly free allowance applies).",
                        "price": [
                          {"service": "AWSGlue", "filters": {"group": "Data catalog requests", "usagetype": "~Catalog-Request"},
                           "per": "1M requests", "scale": 1000000}]}
    },
    "dynamodb": {
      "rules": [
        {"op": "scan", "cost": "variable",
         "note": "Reads the whole table; every 4KB read consumes a read unit. Depends on table size.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-ReadUnits", "usagetype": "~ReadRequestUnits"},
            "per": "1M read request units (on-demand)", "scale": 1000000}]},
        {"op": ["execute-statement", "batch-execute-statement", "execute-transaction"], "cost": "variable",
         "note": "A PartiQL statement without a key condition can do a full table scan.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-ReadUnits", "usagetype": "~ReadRequestUnits"},
            "per": "1M read request units (on-demand)", "scale": 1000000}]},
        {"op": ["get-item", "batch-get-item", "query", "transact-get-items"], "cost": "request",
         "note": "Consumes read units.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-ReadUnits", "usagetype": "~ReadRequestUnits"},
            "per": "1M read request units (on-demand)", "scale": 1000000}]},
        {"op": ["put-item", "update-item", "delete-item", "batch-write-item", "transact-write-items"], "cost": "request",
         "note": "Consumes write units.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-WriteUnits", "usagetype": "~WriteRequestUnits"},
            "per": "1M write request units (on-demand)", "scale": 1000000}]},
        {"op": "create-table", "when": {"--billing-mode": "PAY_PER_REQUEST"}, "cost": "usage",
         "note": "On-demand: only storage is billed while idle.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"productFamily": "Database Storage", "volumeType": "Amazon DynamoDB - Indexed DataStore"},
            "per": "GB-month"}]},
        {"op": "create-table", "cost": "recurring",
         "note": "Default PROVISIONED mode: read/write capacity is billed hourly even if unused.",
         "show": ["--provisioned-throughput.ReadCapacityUnits", "--provisioned-throughput.WriteCapacityUnits"],
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-ReadUnits", "usagetype": "~ReadCapacityUnit-Hrs"},
            "per": "RCU-hour"},
           {"service": "AmazonDynamoDB", "filters": {"group": "DDB-WriteUnits", "usagetype": "~WriteCapacityUnit-Hrs"},
            "per": "WCU-hour"}]},
        {"op": "update-table", "cost": "recurring", "note": "Capacity, replica or table class changes can change the monthly cost."},
        {"op": ["create-backup", "update-continuous-backups"], "cost": "recurring",
         "note": "Backups and point-in-time recovery are billed per GB-month.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"usagetype": "~TimedBackupStorage-ByteHrs"}, "per": "GB-month (backup)"},
           {"service": "AmazonDynamoDB", "filters": {"usagetype": "~TimedPITRStorage-ByteHrs"}, "per": "GB-month (PITR)"}]},
        {"op": "restore-table-*", "cost": "variable", "note": "Billed per GB restored.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"usagetype": "~RestoreDataSize-Bytes"}, "per": "GB restored"}]},
        {"op": "export-table-to-point-in-time", "cost": "variable", "note": "Billed per GB exported.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"volumeType": "Amazon DynamoDB - Export Size"}, "per": "GB exported"}]},
        {"op": "import-table", "cost": "variable", "note": "Billed per GB imported.",
         "price": [
           {"service": "AmazonDynamoDB", "filters": {"usagetype": "~ImportDataSize-Bytes"}, "per": "GB imported"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "lambda": {
      "rules": [
        {"op": ["invoke", "invoke-async", "invoke-with-response-stream"], "cost": "request",
         "note": "Billed per request + duration (GB-seconds); a monthly free allowance applies.",
         "price": [
           {"service": "AWSLambda", "filters": {"group": "AWS-Lambda-Requests", "usagetype": "~Request"},
            "per": "1M requests", "scale": 1000000},
           {"service": "AWSLambda", "filters": {"group": "AWS-Lambda-Duration", "usagetype": "~Lambda-GB-Second"},
            "per": "GB-second (x86)"}]},
        {"op": ["create-function", "update-function-code"], "cost": "usage", "note": "Free while idle; billed per invocation."},
        {"op": "put-provisioned-concurrency-config", "cost": "recurring",
         "note": "Provisioned concurrency is billed per GB-second of allocated memory, even if unused.",
         "show": ["--provisioned-concurrent-executions"],
         "price": [
           {"service": "AWSLambda", "filters": {"group": "AWS-Lambda-Provisioned-Concurrency",
                                                "usagetype": "~Lambda-Provisioned-Concurrency"},
            "per": "GB-second (x86)"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "logs": {
      "rules": [
        {"op": "start-query", "cost": "variable", "note": "Logs Insights is billed per GB of data scanned.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"group": "Queried Logs", "usagetype": "~DataScanned-Bytes"},
            "per": "GB scanned"}]},
        {"op": "start-live-tail", "cost": "request", "note": "Live Tail is billed per minute of session.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"operation": "StartLiveTail", "usagetype": "~Logs-LiveTail"},
            "per": "minute"}]},
        {"op": ["create-log-group", "put-log-events"], "cost": "usage",
         "note": "Ingestion per GB + storage per GB-month. Default retention is forever; set a retention policy.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"group": "Ingested Logs", "operation": "PutLogEvents",
                                                       "usagetype": "~DataProcessing-Bytes"},
            "per": "GB ingested"},
           {"service": "AmazonCloudWatch", "filters": {"productFamily": "Storage Snapshot", "usagetype": "~TimedStorage-ByteHrs"},
            "per": "GB-month stored"}]}
      ],
      "default_read": {"cost": "free", "confidence": "low",
                       "note": "No separate charge known for GetLogEvents/FilterLogEvents; needs verification."},
      "default_write": {"cost": "free"}
    },
    "cloudwatch": {
      "rules": [
        {"op": ["get-metric-data", "get-insight-rule-report"], "cost": "request",
         "note": "Billed per metric requested (not covered by the free tier).",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"operation": "GetMetricData", "usagetype": "~CW:GMD-Metrics"},
            "per": "1,000 metrics", "scale": 1000}]},
        {"op": "get-metric-widget-image", "cost": "request", "note": "Billed per metric in the image.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"operation": "GetMetricWidgetImage", "usagetype": "~CW:GMWI-Metrics"},
            "per": "1,000 metrics", "scale": 1000}]},
        {"op": "put-metric-alarm", "cost": "recurring",
         "note": "Billed monthly per alarm (high-resolution alarms cost more).",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"productFamily": "Alarm", "usagetype": "~CW:AlarmMonitorUsage"},
            "per": "month", "idle": "month"}]},
        {"op": "put-composite-alarm", "cost": "recurring", "note": "Billed monthly per composite alarm.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"productFamily": "Alarm", "usagetype": "~CW:CompositeAlarmMonitorUsage"},
            "per": "month", "idle": "month"}]},
        {"op": "put-dashboard", "cost": "recurring",
         "note": "Billed monthly per dashboard beyond the free ones. Not in the Price List API; see the CloudWatch pricing page."},
        {"op": "put-metric-data", "cost": "usage",
         "note": "Billed per request; each new custom metric is billed monthly.",
         "price": [
           {"service": "AmazonCloudWatch", "filters": {"group": "CW-Requests", "usagetype": "~CW:Requests"},
            "per": "1,000 requests", "scale": 1000},
           {"service": "AmazonCloudWatch", "filters": {"productFamily": "Metric", "usagetype": "~CW:MetricMonitorUsage"},
            "per": "metric-month"}]}
      ],
      "default_read": {"cost": "request", "note": "CloudWatch API request (a monthly free allowance applies).",
                       "price": [
                         {"service": "AmazonCloudWatch", "filters": {"group": "CW-Requests", "usagetype": "~CW:Requests"},
                          "per": "1,000 requests", "scale": 1000}]},
      "default_write": {"cost": "request", "note": "CloudWatch API request (a monthly free allowance applies).",
                        "price": [
                          {"service": "AmazonCloudWatch", "filters": {"group": "CW-Requests", "usagetype": "~CW:Requests"},
                           "per": "1,000 requests", "scale": 1000}]}
    },
    "ce": {
      "rules": [
        {"op": "*", "cost": "request", "note": "Every Cost Explorer API request is billed (each page is a request).",
         "price": [
           {"service": "AWSCostExplorer", "filters": {"productFamily": "API Request", "usagetype": "~APIRequest",
                                                      "regionCode": "us-east-1"},
            "global": true, "per": "request"}]}
      ]
    },
    "kms": {
      "rules": [
        {"op": ["create-key", "replicate-key"], "cost": "recurring",
         "note": "Billed monthly per customer managed key (rotation adds key versions).",
         "price": [
           {"service": "awskms", "filters": {"productFamily": "Encryption Key", "usagetype": "~KMS-Keys"},
            "per": "month", "idle": "month"}]},
        {"op": ["schedule-key-deletion", "cancel-key-deletion"], "cost": "free"}
      ],
      "default_read": {"cost": "request", "note": "KMS API request (a monthly free allowance applies).",
                       "price": [
                         {"service": "awskms", "filters": {"group": "awskms-APIRequest-All"},
                          "per": "10,000 requests", "scale": 10000}]},
      "default_write": {"cost": "request", "note": "KMS API request (a monthly free allowance applies).",
                        "price": [
                          {"service": "awskms", "filters": {"group": "awskms-APIRequest-All"},
                           "per": "10,000 requests", "scale": 10000}]}
    },
    "secretsmanager": {
      "rules": [
        {"op": ["create-secret", "replicate-secret-to-regions"], "cost": "recurring",
         "note": "Billed monthly per secret (and per replica), plus API calls.",
         "price": [
           {"service": "AWSSecretsManager", "filters": {"productFamily": "Secret"}, "per": "month", "idle": "month"}]}
      ],
      "default_read": {"cost": "request", "note": "Secrets Manager API call.",
                       "price": [
                         {"service": "AWSSecretsManager", "filters": {"productFamily": "API Request"},
                          "per": "10,000 API calls", "scale": 10000}]},
      "default_write": {"cost": "request", "note": "Secrets Manager API call.",
                        "price": [
                          {"service": "AWSSecretsManager", "filters": {"productFamily": "API Request"},
                           "per": "10,000 API calls", "scale": 10000}]}
    },
    "ssm": {
      "rules": [
        {"op": "put-parameter", "when": {"--tier": ["Advanced", "Intelligent-Tiering"]}, "cost": "recurring",
         "note": "Advanced parameters are billed hourly per parameter, plus higher-throughput API fees.",
         "price": [
           {"service": "AWSSystemsManager", "filters": {"usagetype": "~PS-Advanced-Param-Tier1"},
            "per": "hour", "idle": "hour"}]},
        {"op": "put-parameter", "cost": "free", "note": "Standard parameters are free."}
      ],
      "default_read": {"cost": "free", "note": "Free at standard throughput."},
      "default_write": {"cost": "free", "confidence": "low",
                        "note": "Run Command/Session Manager are free for EC2; Automation and on-prem nodes may be billed."}
    },
    "rds": {
      "rules": [
        {"op": ["create-db-instance", "create-db-cluster", "create-db-instance-read-replica", "restore-db-instance-*",
                "restore-db-cluster-*", "start-db-instance", "start-db-cluster", "create-db-proxy",
                "create-blue-green-deployment", "create-global-cluster", "modify-db-instance", "modify-db-cluster"],
         "cost": "recurring", "note": "Hourly by instance class + storage per GB-month. Multi-AZ doubles the cost.",
         "price": "rds", "show": ["--engine", "--db-instance-class", "--multi-az", "--allocated-storage", "--storage-type", "--iops"]},
        {"op": ["create-db-snapshot", "create-db-cluster-snapshot", "copy-db-snapshot", "copy-db-cluster-snapshot"],
         "cost": "recurring", "note": "Manual snapshot storage is billed per GB-month."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elbv2": {
      "rules": [
        {"op": "create-load-balancer", "when": {"--type": "network"}, "cost": "recurring",
         "note": "Network Load Balancer: billed hourly while it exists, plus capacity units (NLCU) used.",
         "price": [
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Network",
                                             "groupDescription": "LoadBalancer hourly usage by Network Load Balancer"},
            "per": "hour", "idle": "hour"},
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Network",
                                             "groupDescription": "Used Network Load Balancer capacity units-hr"},
            "per": "NLCU-hour"}]},
        {"op": "create-load-balancer", "when": {"--type": "gateway"}, "cost": "recurring",
         "note": "Gateway Load Balancer: billed hourly while it exists, plus capacity units (GLCU) used.",
         "price": [
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Gateway",
                                             "groupDescription": "LoadBalancer hourly usage by Gateway Load Balancer"},
            "per": "hour", "idle": "hour"},
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Gateway",
                                             "groupDescription": "Used Gateway Load Balancer capacity units-hr"},
            "per": "GLCU-hour"}]},
        {"op": "create-load-balancer", "cost": "recurring",
         "note": "Application Load Balancer: billed hourly while it exists, plus capacity units (LCU) used.",
         "price": [
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Application",
                                             "groupDescription": "LoadBalancer hourly usage by Application Load Balancer"},
            "per": "hour", "idle": "hour"},
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer-Application",
                                             "groupDescription": "Used Application Load Balancer capacity units-hr"},
            "per": "LCU-hour"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elb": {
      "rules": [
        {"op": "create-load-balancer", "cost": "recurring",
         "note": "Classic Load Balancer: billed hourly while it exists, plus per GB processed.",
         "price": [
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer", "usagetype": "~LoadBalancerUsage"},
            "per": "hour", "idle": "hour"},
           {"service": "AWSELB", "filters": {"productFamily": "Load Balancer", "usagetype": "~DataProcessing-Bytes"},
            "per": "GB processed"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "route53": {
      "rules": [
        {"op": "create-hosted-zone", "cost": "recurring", "note": "Billed monthly per hosted zone, plus DNS queries.",
         "price": [
           {"service": "AmazonRoute53", "filters": {"productFamily": "DNS Zone", "usagetype": "HostedZone"},
            "global": true, "per": "month", "idle": "month"}]},
        {"op": "create-health-check", "cost": "recurring",
         "note": "Billed monthly per health check (endpoints outside AWS cost more; this is that price).",
         "price": [
           {"service": "AmazonRoute53", "filters": {"productFamily": "DNS Health Check", "usagetype": "Health-Check-Non-AWS"},
            "global": true, "per": "month", "idle": "month"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "route53domains": {
      "rules": [
        {"op": ["register-domain", "transfer-domain", "renew-domain"], "cost": "one_time",
         "note": "Domain fee depends on the TLD and is usually non-refundable."}
      ],
      "default_read": {"cost": "free"}
    },
    "sqs": {
      "rules": [
        {"op": "create-queue", "cost": "usage", "note": "Free while idle; billed per request."},
        {"op": "*", "cost": "request", "note": "Every API request is billed (a monthly free allowance applies).",
         "price": [
           {"service": "AWSQueueService", "filters": {"group": "SQS-APIRequest-Tier1", "usagetype": "~Requests-"},
            "exclude": {"usagetype": ["FIFO", "Fair"]},
            "per": "1M requests (standard queue)", "scale": 1000000}]}
      ]
    },
    "sns": {
      "rules": [
        {"op": "publish", "when": {"--phone-number": true}, "cost": "request",
         "note": "SMS is billed per message and varies by country."},
        {"op": ["publish", "publish-batch"], "cost": "request",
         "note": "Billed per publish (a monthly free allowance applies) + delivery fees.",
         "price": [
           {"service": "AmazonSNS", "filters": {"group": "SNS-Requests-Tier1", "usagetype": "~Requests-Tier1"},
            "per": "1M publishes", "scale": 1000000}]},
        {"op": "create-topic", "cost": "usage", "note": "Free while idle."}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "cloudformation": {
      "rules": [
        {"op": ["create-stack", "update-stack", "deploy", "create-change-set", "execute-change-set",
                "create-stack-set", "update-stack-set", "create-stack-instances"],
         "cost": "variable", "note": "Cost depends on the resources the stack creates; review the template."},
        {"op": ["package", "validate-template", "estimate-template-cost"], "cost": "free"}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "ecs": {
      "rules": [
        {"op": ["create-service", "update-service", "run-task", "start-task"], "cost": "recurring",
         "note": "Fargate: vCPU-hours + GB-hours; EC2 launch type: the underlying instances.",
         "show": ["--launch-type", "--desired-count", "--count"],
         "price": [
           {"service": "AmazonECS", "filters": {"usagetype": "~Fargate-vCPU-Hours:perCPU"}, "per": "vCPU-hour (Fargate)"},
           {"service": "AmazonECS", "filters": {"usagetype": "~Fargate-GB-Hours"}, "per": "GB-hour (Fargate)"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "eks": {
      "rules": [
        {"op": "create-cluster", "cost": "recurring",
         "note": "The control plane is billed hourly while the cluster exists; nodes are billed separately.",
         "price": [
           {"service": "AmazonEKS", "filters": {"usagetype": "~AmazonEKS-Hours:perCluster"}, "per": "hour", "idle": "hour"},
           {"service": "AmazonEKS", "filters": {"usagetype": "~AmazonEKS-Hours:extendedSupport"},
            "per": "hour more on a version in extended support"}]},
        {"op": ["create-nodegroup", "update-nodegroup-config"], "cost": "recurring", "note": "Node instances are billed hourly.",
         "show": ["--instance-types", "--capacity-type", "--scaling-config.desiredSize", "--scaling-config.maxSize"]},
        {"op": "create-fargate-profile", "cost": "usage", "note": "vCPU/GB-hours billed while pods run.",
         "price": [
           {"service": "AmazonECS", "filters": {"usagetype": "~Fargate-vCPU-Hours:perCPU"}, "per": "vCPU-hour (Fargate)"},
           {"service": "AmazonECS", "filters": {"usagetype": "~Fargate-GB-Hours"}, "per": "GB-hour (Fargate)"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "ecr": {
      "rules": [
        {"op": "create-repository", "cost": "usage", "note": "Image storage is billed per GB-month.",
         "price": [
           {"service": "AmazonECR", "filters": {"usagetype": "~TimedStorage-ByteHrs"}, "per": "GB-month"}]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "elasticache": {
      "rules": [
        {"op": ["create-cache-cluster", "create-replication-group", "create-serverless-cache", "modify-cache-cluster",
                "modify-replication-group", "increase-replica-count"], "cost": "recurring",
         "note": "Billed hourly by node type.",
         "show": ["--cache-node-type", "--num-cache-nodes", "--num-node-groups", "--replicas-per-node-group"]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "opensearch": {
      "rules": [
        {"op": ["create-domain", "update-domain-config"], "cost": "recurring", "note": "Instance-hours + EBS GB-month.",
         "show": ["--cluster-config.InstanceType", "--cluster-config.InstanceCount", "--ebs-options.VolumeSize"]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "redshift": {
      "rules": [
        {"op": ["create-cluster", "resume-cluster", "restore-from-cluster-snapshot", "modify-cluster", "resize-cluster"],
         "cost": "recurring", "note": "Billed per node-hour.", "show": ["--node-type", "--number-of-nodes"]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "sagemaker": {
      "rules": [
        {"op": ["create-endpoint", "update-endpoint", "create-notebook-instance", "start-notebook-instance",
                "create-inference-component"], "cost": "recurring",
         "note": "Billed hourly while the instance is up (GPU instances are expensive).", "show": ["--instance-type"]},
        {"op": ["create-training-job", "create-processing-job", "create-transform-job", "create-hyper-parameter-tuning-job"],
         "cost": "variable", "note": "Instance type × duration.",
         "show": ["--resource-config.InstanceType", "--resource-config.InstanceCount",
                  "--processing-resources.InstanceType", "--processing-resources.InstanceCount",
                  "--transform-resources.InstanceType", "--transform-resources.InstanceCount"]}
      ],
      "default_read": {"cost": "free"},
      "default_write": {"cost": "free"}
    },
    "bedrock-runtime": {
      "rules": [
        {"op": "*", "cost": "variable", "note": "Billed by model and token count."}
      ]
    }
  }
}
